const icon = (name: 'arrow' | 'chevron' | 'pin' | 'phone' | 'mail' | 'instagram' | 'clock' | 'close') => {
  const shared = 'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"';
  const paths: Record<string, string> = {
    arrow: '<path d="M5 12h13M13 6l6 6-6 6" />',
    chevron: '<path d="m6 9 6 6 6-6" />',
    pin: '<path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5" />',
    phone: '<path d="M21 16.7v2.1a1.7 1.7 0 0 1-1.9 1.7 16.7 16.7 0 0 1-7.3-2.6 16.4 16.4 0 0 1-5.7-5.7 16.7 16.7 0 0 1-2.6-7.3A1.7 1.7 0 0 1 5.2 3h2.1a1.7 1.7 0 0 1 1.7 1.4c.1 1 .4 2 .7 2.8a1.7 1.7 0 0 1-.4 1.8L8.4 10a13.6 13.6 0 0 0 5.7 5.7l1-1a1.7 1.7 0 0 1 1.8-.4c.8.3 1.8.6 2.8.7a1.7 1.7 0 0 1 1.3 1.7Z" />',
    mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6" />',
    instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01" />',
    clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2" />',
    close: '<path d="m6 6 12 12M18 6 6 18" />'
  };
  return `<svg ${shared}>${paths[name]}</svg>`;
};

